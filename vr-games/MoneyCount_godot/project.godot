; Engine configuration file.
config_version=5

[application]
config/name="지폐 세기 놀이터"
config/use_custom_user_dir=true
config/custom_user_dir_name="MoneyCount"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(1, 0.96, 0.88, 1)
boot_splash/show_image=false

[audio]
general/text_to_speech=true

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]
theme/custom_font="res://Jua.ttf"

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
textures/canvas_textures/default_texture_filter=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(1, 0.96, 0.88, 1)
